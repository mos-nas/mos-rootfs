#! /bin/sh
### BEGIN INIT INFO
# Provides:          nut-server upsd
# Required-Start:    $local_fs $syslog $network $remote_fs udev
# Required-Stop:     $local_fs $syslog $network $remote_fs udev
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Network UPS Tools initscript
# Description:       This script take care of starting and stopping the
#                    Network UPS Tools components. When needed, it also
#                    handle the UPS hardware shutdown.
### END INIT INFO

# Author: Arnaud Quette <aquette@debian.org>

PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin

NAME=nut-server
DESC="NUT - power devices information server and drivers"
CONFIG=/etc/nut/nut.conf
pid_dir=/run/nut
upsd_pid=${pid_dir}/upsd.pid
upsd=/sbin/upsd
upsdrvctl=/sbin/upsdrvctl
log=">/dev/null 2>/dev/null"

# Define LSB log_* functions.
# Depend on lsb-base (>= 3.0-6) to ensure that this file is present.
. /lib/lsb/init-functions

# set upsd specific options. use "man upsd" for more info
# this parameter is now located in nut.conf, and not in /etc/default/nut anymore
# FIXME: retrieved from 'nut' script during update 
UPSD_OPTIONS=""

# Exit if the package is not installed
[ -x "$upsd" ] || exit 0

# MOS Custom: remove existing deprecated config files
# and remove directory if empty
[ -f "/boot/config/system/nut/nut.conf" ] \
  && rm -f /boot/config/system/nut/nut.conf
[ -f "/boot/config/system/nut/ups.conf" ] \
  && rm -f /boot/config/system/nut/ups.conf
[ -f "/boot/config/system/nut/upsd.conf" ] \
  && rm -f /boot/config/system/nut/upsd.conf
[ -f "/boot/config/system/nut/upsd.users" ] \
  && rm -f /boot/config/system/nut/upsd.users
[ -f "/boot/config/system/nut/upsmon.conf" ] \
  && rm -f /boot/config/system/nut/upsmon.conf
[ -f "/boot/config/system/nut/upssched.conf" ] \
  && rm -f /boot/config/system/nut/upssched.conf
rmdir /boot/config/system/nut 2>/dev/null

# MOS Custom: render /etc/nut files from json
NUT_JSON="/boot/config/system/nut.json"

configure_nut() {
  [ -f "$NUT_JSON" ] || return 0

  mkdir -p /etc/nut

  ENABLED=$(jq -r '.enabled // false' "$NUT_JSON")
  MODE=$(jq -r '.mode // "standalone"' "$NUT_JSON")
  [ "$ENABLED" = "true" ] || MODE="none"

  echo "MODE=$MODE" > /etc/nut/nut.conf

  if [ "$MODE" = "none" ] ; then
    chown -R nut:nut /etc/nut 2>/dev/null || true
    return 0
  fi

  if [ "$MODE" = "standalone" ] || [ "$MODE" = "netserver" ] ; then
    {
      echo "[$(jq -r '.server.ups.name // "ups"' "$NUT_JSON")]"
      jq -r '"driver = \(.server.ups.driver // "usbhid-ups")"' "$NUT_JSON"
      jq -r '"port = \(.server.ups.port // "auto")"' "$NUT_JSON"
      UPS_DESC=$(jq -r '.server.ups.desc // ""' "$NUT_JSON")
      [ -n "$UPS_DESC" ] && echo "desc = \"$UPS_DESC\""
      jq -r '(.server.ups.extra // {}) | to_entries[] | "\(.key) = \(.value)"' "$NUT_JSON"
    } > /etc/nut/ups.conf

    jq -r '(.server.listen // [])[] | "LISTEN \(.address) \(.port)"' "$NUT_JSON" > /etc/nut/upsd.conf

    jq -r '
      (.server.users // [])[] |
      "[\(.username)]",
      "password = \(.password // "")",
      ((.actions // [])[] | "actions = \(.)"),
      ((.instcmds // [])[] | "instcmds = \(.)"),
      (if .upsmon then "upsmon \(.upsmon)" else empty end),
      ""
    ' "$NUT_JSON" > /etc/nut/upsd.users
  fi

  {
    echo "RUN_AS_USER root"
    jq -r '"MONITOR \(.monitor.upsname // "ups")@\(.monitor.host // "127.0.0.1"):\(.monitor.port // 3493) \(.monitor.powervalue // 1) \(.monitor.username // "") \(.monitor.password // "") \(.monitor.role // "primary")"' "$NUT_JSON"
    jq -r '"MINSUPPLIES \(.shutdown.minsupplies // 1)"' "$NUT_JSON"
    jq -r '"SHUTDOWNCMD \"\(.shutdown.command // "/sbin/shutdown -h +0")\""' "$NUT_JSON"
    jq -r '"POWERDOWNFLAG \(.shutdown.powerdownflag // "/etc/killpower")"' "$NUT_JSON"
    jq -r '"FINALDELAY \(.shutdown.finaldelay // 5)"' "$NUT_JSON"
    jq -r '"POLLFREQ \(.timers.pollfreq // 5)"' "$NUT_JSON"
    jq -r '"POLLFREQALERT \(.timers.pollfreqalert // 5)"' "$NUT_JSON"
    jq -r '"HOSTSYNC \(.timers.hostsync // 15)"' "$NUT_JSON"
    jq -r '"DEADTIME \(.timers.deadtime // 15)"' "$NUT_JSON"
    jq -r '"RBWARNTIME \(.timers.rbwarntime // 43200)"' "$NUT_JSON"
    jq -r '"NOCOMMWARNTIME \(.timers.nocommwarntime // 300)"' "$NUT_JSON"
    echo "NOTIFYCMD /etc/nut/mos-notify"
    for EV in ONLINE ONBATT SHUTDOWN LOWBATT FSD COMMBAD NOCOMM NOPARENT REPLBATT ; do
      echo "NOTIFYFLAG $EV SYSLOG+EXEC"
    done
  } > /etc/nut/upsmon.conf

  printf '#!/bin/sh\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\nexec mos-api_cli ups:event "$NOTIFYTYPE"\n' > /etc/nut/mos-notify
  chmod +x /etc/nut/mos-notify

  if [ "$(jq -r '.shutdown.mode // "lowbattery"' "$NUT_JSON")" = "timer" ] ; then
    TIMER=$(jq -r '.shutdown.timer_seconds // 180' "$NUT_JSON")
    mkdir -p /run/nut/upssched
    {
      echo "CMDSCRIPT /etc/nut/mos-upssched-cmd"
      echo "PIPEFN /run/nut/upssched/upssched.pipe"
      echo "LOCKFN /run/nut/upssched/upssched.lock"
      echo "AT ONBATT * START-TIMER mos-upsshutdown $TIMER"
      echo "AT ONLINE * CANCEL-TIMER mos-upsshutdown"
    } > /etc/nut/upssched.conf
    printf '#!/bin/sh\ncase "$1" in\n  mos-upsshutdown) /sbin/upsmon -c fsd ;;\nesac\n' > /etc/nut/mos-upssched-cmd
    chmod +x /etc/nut/mos-upssched-cmd
  else
    rm -f /etc/nut/upssched.conf /etc/nut/mos-upssched-cmd 2>/dev/null || true
  fi

  chown -R nut:nut /etc/nut 2>/dev/null || true
  chmod 640 /etc/nut/upsd.users 2>/dev/null || true
}

configure_nut

# Include NUT nut.conf
[ -r $CONFIG ] && . $CONFIG

# Explicitly require the configuration to be done in /etc/nut/nut.conf
# redundant with nut-client
if [ "x$MODE" = "xnone" -o -z "$MODE" ] ; then
  log_action_msg "$NAME disabled, please adjust the configuration to your needs"
  log_action_msg "Then set MODE to a suitable value in $CONFIG to enable it"
  # exit success to avoid breaking the install process!
  exit 0
fi

# Check if /run/nut exists and has the correct perms
check_var_directory() {
  [ ! -d ${pid_dir} ] && mkdir -p ${pid_dir} \
    && chown root:nut ${pid_dir} \
    && chmod 770 ${pid_dir} \
    && [ -x /sbin/restorecon ] && /sbin/restorecon ${pid_dir}
}

# check if the right components are running
check_status() {
  case "$MODE" in
    standalone|netserver)
      status_of_proc -p $upsd_pid $upsd upsd
      # FIXME: need driver(s) status too!
    ;;
    none|netclient|*)
      # defered to nut-client
      #status_of_proc -p $upsmon_pid $upsmon upsmon
    ;;
  esac
}

# MOS Custom
start_stop_server () {
  ES=0
  case "$MODE" in
    standalone|netserver)
      case "$1" in
        start)
          # First, start driver(s)
          $upsdrvctl start >/dev/null 2>&1 || ES=1
          # Then, data server (upsd)
          start-stop-daemon -S -p $upsd_pid -x $upsd \
            -- $UPSD_OPTIONS >/dev/null 2>&1 || ES=1
          return $ES
        ;;
        stop)
          # FIXME: should stop nut-client first!
          # Reverse order for stop
          start-stop-daemon -K -o -p $upsd_pid -n upsd || ES=1
          /sbin/upsdrvctl stop >/dev/null 2>&1 || ES=1
          return $ES
        ;;
      esac
    ;;
    none|netclient|*)
      # now handled by nut-client
      return 1
    ;;
  esac
}

case "$1" in

  start)
    log_daemon_msg "Starting $DESC" "$NAME"
    check_var_directory
    start_stop_server start #&& log_progress_msg "upsd"
    #start_stop_client start && log_progress_msg "upsmon"
    log_end_msg $?
  ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    if [ -f "$upsd_pid" ] ; then
      start_stop_server stop
    fi
    log_end_msg $?
    #&& log_progress_msg "upsd"
    #start_stop_client stop && log_progress_msg "upsmon"
  ;;
  reload)
    $upsd   -c reload >/dev/null 2>&1
    #$upsmon -c reload >/dev/null 2>&1
  ;;
  restart|force-reload)
    log_daemon_msg "Restarting $DESC" "$NAME"
    #start_stop_client stop
    start_stop_server stop
    sleep 5
    check_var_directory
    start_stop_server start #&& log_progress_msg "upsd"
    #start_stop_client start && log_progress_msg "upsmon"
    log_end_msg $?
  ;;
  status)
    #log_daemon_msg "Checking status of $DESC"
    echo "Checking status of $DESC" "$NAME"
    check_status
    exit $?
  ;;
  poweroff)
    wait_delay=`sed -ne 's#^ *POWEROFF_WAIT= *\(.*\)$#\1#p' /etc/nut/nut.conf`
    # UPS poweroff action is actually done here.
    # But nut-monitor (Ie nut-client) does the check and call nut-server if needed!
    # This action MUST NOT be called directly, and thus is not exposed in 'Usage'
    case "$MODE" in
      standalone|netserver)
        log_daemon_msg "Shutting down the UPS ..."
        if $upsdrvctl shutdown ; then
          # FIXME (needed?): sleep 5
          log_progress_msg "Waiting for UPS to cut the power"
          log_end_msg $?
        else
          log_progress_msg "Shutdown failed."
          log_progress_msg "Waiting for UPS batteries to run down"
          log_end_msg 0
        fi
        if [ -n "$wait_delay" ] ; then
          log_daemon_msg " (will reboot after $wait_delay) ..."
          sleep "$wait_delay"
          invoke-rc.d reboot stop
        fi
      ;;
      none|netclient|*)
        # nothing to do
      ;;
    esac
  ;;
  *)
    N=/etc/init.d/$NAME
    echo "Usage: $N {start|stop|reload|restart|force-reload|status}" >&2
    exit 1
  ;;
esac

exit 0
